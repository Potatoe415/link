{
  "id": "apibay",
  "name": "The Pirate Bay",
  "type": "api",
  "urls": {
    "primary": "https://apibay.org/q.php?q={{q}}",
    "mirrors": [
      "https://tpb.party/search/{{q}}/1/99/0",
      "https://thepiratebay10.xyz/search/{{q}}/1/99/0",
      "https://thepiratebay.zone/search/{{q}}/1/99/0",
      "https://piratebay.live/search/{{q}}/1/99/0",
      "https://thehiddenbay.com/search/{{q}}/1/99/0",
      "https://thepiratebay.bond/search/{{q}}/1/99/0",
      "https://tpb.unleashed.pw/search/{{q}}/1/99/0",
      "https://pirateproxylive.org/search/{{q}}/1/99/0",
      "https://ukpass.co/search/{{q}}/1/99/0"
    ]
  },
  "selectors": {
    "rows": "table#searchResult tr",
    "title": "div.detName a, a.detLink",
    "magnet": "a[href^=\"magnet:\"]",
    "seeders": "td:nth-last-child(2)",
    "description": "font.detDesc, .detDesc"
  }
}
